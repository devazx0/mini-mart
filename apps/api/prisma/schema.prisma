// Prisma schema for mini-mart (PostgreSQL, local).
// Connection URL lives in prisma7.config.ts and reads DATABASE_URL.
// NOTE: URL-encode special chars in the password (# -> %23).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String?
  seller      User?    @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: SetNull)
  name        String
  description String   @default("")
  price       Decimal  @db.Decimal(10, 2)
  oldPrice    Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  imageUrl    String   @default("")
  category    String   @default("general")
  categorySlug String  @default("all")
  rating      Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount Int      @default(0)
  freeDelivery Boolean @default(false)
  badge       String?
  storeName   String   @default("ApexMarket")
  storeLocation String @default("Lagos")
  verified    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([sellerId, updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id                String   @id @default(cuid())
  orderNo           String   @unique
  buyerId           String
  subtotal          Decimal  @db.Decimal(10, 2)
  shippingFee       Decimal  @db.Decimal(10, 2)
  total             Decimal  @db.Decimal(10, 2)
  paymentMethod     String   @default("transfer")
  escrowStatus      String   @default("required")
  fulfillmentStatus String   @default("processing")
  addressLine       String   @default("Lekki Phase 1, Lagos")
  merchantName      String   @default("")
  itemName          String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  buyer             User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  escrow            EscrowTransaction?

  @@index([buyerId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  sellerId  String?
  seller    User?   @relation("SellerOrderItems", fields: [sellerId], references: [id], onDelete: SetNull)
  name      String
  imageUrl  String  @default("")
  qty       Int
  unitPrice Decimal @db.Decimal(10, 2)
  storeName String  @default("")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([sellerId])
}

model EscrowTransaction {
  id            String    @id @default(cuid())
  orderId       String    @unique
  bankName      String    @default("Wema Bank")
  accountName   String    @default("ApexMarket Escrow")
  accountNumber String    @default("0123456789")
  status        String    @default("pending")
  expiresAt     DateTime
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WalletAccount {
  userId    String   @id
  balance   Decimal  @default(120000) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletLedger {
  id           String   @id @default(cuid())
  userId       String
  orderId      String?
  delta        Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @db.Decimal(12, 2)
  reason       String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BuyerNotification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  buyer
  seller
  admin
}

model User {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  email         String         @unique
  password      String
  phone         String?
  dob           DateTime
  role          UserRole       @default(buyer)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  cartItems     CartItem[]
  orders        Order[]
  products      Product[]   @relation("SellerProducts")
  soldItems     OrderItem[] @relation("SellerOrderItems")
  walletAccount WalletAccount?
  walletLedger  WalletLedger[]
  notifications BuyerNotification[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
